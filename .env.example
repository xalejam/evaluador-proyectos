# Copia este archivo a .env y completa con tus credenciales reales.
# .env está en .gitignore y nunca debe commitearse.

# Connection string de Supabase (Session pooler, IPv4) para la app en modo cloud.
# Si no se define (o el archivo .env no existe), la app usa SQLite local.
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-1-us-east-1.pooler.supabase.co:5432/postgres
